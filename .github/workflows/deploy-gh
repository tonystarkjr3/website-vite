name: Build and deploy to GitHub Pages

on:
  push:
    branches: [ "Main" ]
  workflow_dispatch:

permissions:
  contents: read
  pages: write

jobs:
  build-deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Use Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '18'
          cache: 'npm'

      - name: Install dependencies
        run: npm ci

      - name: Build site
        run: npm run build

      - name: Debug listing (optional)
        run: |
          echo "Workspace: $GITHUB_WORKSPACE"
          ls -la
          ls -la dist || true
          test -f dist/index.html && sed -n '1,60p' dist/index.html || true

      - name: Deploy to gh-pages
        uses: peaceiris/actions-gh-pages@v4
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          publish_dir: ./dist
          publish_branch: gh-pages
